---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site, url } from '../config/site';
---

<BaseLayout
  title="Contact GLCL"
  description="Contact GET Labour Company Limited in Tema, Ghana — telephone +233 30 396 1288, +233 55 800 7876, email getlabourcompanylimited@gmail.com. Tema Meridian Road, near the Tema Port enclave."
>
  <PageHero
    eyebrow="Contact"
    title="Reach the GLCL team"
    lead="Call, email, or send a message through the form. For labour requests and job applications, the dedicated forms reach the right team faster."
  />

  <section class="section section--tight">
    <div class="container contact-grid contact-grid--3" data-reveal>
      <a class="contact-card" href={`tel:${site.phones[0].tel}`}>
        <div class="contact-card__icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.4 2.1L8.1 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.4 1.9.6 2.9.8a2 2 0 0 1 1.6 1.9z"/></svg>
        </div>
        <p class="contact-card__label">Office line</p>
        <p class="contact-card__value">{site.phones[0].display}</p>
        <p class="contact-card__meta">Tap to call from your phone</p>
      </a>

      <a class="contact-card" href={`tel:${site.phones[1].tel}`}>
        <div class="contact-card__icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.4 2.1L8.1 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.4 1.9.6 2.9.8a2 2 0 0 1 1.6 1.9z"/></svg>
        </div>
        <p class="contact-card__label">Mobile line</p>
        <p class="contact-card__value">{site.phones[1].display}</p>
        <p class="contact-card__meta">Tap to call from your phone</p>
      </a>

      <a class="contact-card" href={`mailto:${site.email}`}>
        <div class="contact-card__icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z"/><path d="m4 6 8 6 8-6"/></svg>
        </div>
        <p class="contact-card__label">Email</p>
        <p class="contact-card__value" style="font-size:var(--text-base);word-break:break-word">{site.email}</p>
        <p class="contact-card__meta">For documents and written enquiries</p>
      </a>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container split split--text-first" style="align-items:start">
      <div class="prose" data-reveal>
        <p class="eyebrow">Location</p>
        <h2 class="mt-0">Find the GLCL office</h2>
        <dl class="info-rows">
          <div class="info-row">
            <dt>Address area</dt>
            <dd>{site.address.line}<br />{site.address.city}, {site.address.region}</dd>
          </div>
          <div class="info-row">
            <dt>Context</dt>
            <dd>{site.address.context} — easy reach of the port, terminals and industrial facilities.</dd>
          </div>
          <div class="info-row">
            <dt>Directions</dt>
            <dd>
              <a class="text-link" href={site.address.mapUrl} target="_blank" rel="noopener noreferrer">
                Open location in Google Maps
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
              </a>
            </dd>
          </div>
        </dl>
        <p class="field-hint" style="margin-top:1.25rem">
          The map link shows the general Meridian Road / Community 2 area in Tema. For
          directions to a specific gate or meeting point, call the office before visiting.
        </p>
        <div class="btn-row" style="margin-top:1.75rem">
          <a class="btn btn--primary" href={url('/request-labour/')}>Request Labour</a>
          <a class="btn btn--outline" href={url('/apply/')}>Apply for Work</a>
        </div>
      </div>

      <div data-reveal>
        <h3 class="mt-0">Send a general enquiry</h3>
        <p class="color-slate" style="font-size:var(--text-sm)">
          For questions that are not a labour request or a job application. If your message is
          about requesting workers or applying for work, please use those forms instead.
        </p>
        <EnquiryForm />
      </div>
    </div>
  </section>
</BaseLayout>
