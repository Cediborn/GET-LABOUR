---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services, url } from '../../config/site';

import yardImg from '../../assets/img/container-yard-aerial.webp';
import warehouseImg from '../../assets/img/warehouse-loading.webp';
import forkliftImg from '../../assets/img/forklift-operations.webp';
import vestsImg from '../../assets/img/supervisor-vests.webp';

const serviceImages: Record<string, ImageMetadata> = {
  'skilled-labour': yardImg,
  'general-labour': warehouseImg,
  'equipment-operators': forkliftImg,
  supervision: vestsImg,
};
---

<BaseLayout
  title="Labour Supply Services"
  description="GLCL provides skilled labour, general and non-skilled labour (onboard, ashore, transit and topside gangs), forklift, reach stacker and crane operators, and supervisory support in Tema, Ghana."
>
  <PageHero
    eyebrow="Services"
    title="Workforce categories for real operational requirements"
    lead="GLCL supplies four categories of labour to businesses around Tema and Ghana’s industrial environment. Each can be requested with the specifics of your operation — numbers, location, timing and required experience."
  />

  <section class="section">
    <div class="container">
      <div class="service-rows">
        {
          services.map((service, i) => (
            <article class="service-row" data-reveal>
              <div class="service-row__media">
                <Image
                  src={serviceImages[service.slug]}
                  alt=""
                  widths={[520, 800, 1100]}
                  sizes="(min-width: 56rem) 50vw, 100vw"
                  loading="lazy"
                />
              </div>
              <div>
                <span class="service-row__index">{`0${i + 1}`}</span>
                <h2 style="font-size:var(--text-xl)">{service.title}</h2>
                <p class="color-slate">{service.short}</p>
                <ul class="chip-list mb-5">
                  {service.categories.map((c) => (
                    <li class="chip">{c.name}</li>
                  ))}
                </ul>
                <div class="btn-row">
                  <a class="text-link" href={url(`/services/${service.slug}/`)}>
                    Service details
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </a>
                  <a class="btn btn--outline" href={url('/request-labour/')}>Request Labour</a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container container--narrow" data-reveal>
      <div class="section-head section-head--center">
        <p class="eyebrow">Before you request</p>
        <h2>What to have ready</h2>
        <p>A good request is a specific one. The more of these you can answer, the faster the discussion with our team goes.</p>
      </div>
      <div class="panel panel--amber">
        <ul class="checklist">
          <li>Type of work and the category of labour involved</li>
          <li>How many workers you need</li>
          <li>Where the work takes place and where people should report</li>
          <li>When you need them and for how long</li>
          <li>Any equipment experience, certification or site safety requirements</li>
        </ul>
      </div>
      <p class="text-center" style="margin-top:2rem">
        <a class="btn btn--accent" href={url('/request-labour/')}>Request Labour</a>
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
