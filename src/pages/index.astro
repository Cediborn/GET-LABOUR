---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import { site, url, services } from '../config/site';

import heroImg from '../assets/img/hero-tema-terminal.webp';
import teamImg from '../assets/img/glcl-team.webp';
import forkliftImg from '../assets/img/forklift-operations.webp';
import yardImg from '../assets/img/container-yard-aerial.webp';
import vesselImg from '../assets/img/vessel-at-sea.webp';
import musterImg from '../assets/img/labour-muster.webp';
import warehouseImg from '../assets/img/warehouse-loading.webp';
import berthImg from '../assets/img/ships-at-berth.webp';
import vestsImg from '../assets/img/supervisor-vests.webp';

const serviceImages: Record<string, ImageMetadata> = {
  'skilled-labour': yardImg,
  'general-labour': warehouseImg,
  'equipment-operators': forkliftImg,
  supervision: vestsImg,
};

const values = [
  {
    title: 'A workforce for every requirement',
    text: 'Skilled trades, general gangs, equipment operators and supervisory staff — one supplier for different operational needs.',
    icon: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8',
  },
  {
    title: 'Vetting before placement',
    text: 'Workers are checked against the requirements you give us before an assignment is arranged, so roles are matched properly.',
    icon: 'M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11',
  },
  {
    title: 'Safety-aware working practices',
    text: 'A workforce approach that takes safe working practices seriously, with supervisors and a safety officer within the company structure.',
    icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
  },
  {
    title: 'Based in the Tema Port enclave',
    text: 'Located around Tema Community 2 — close to the port, terminals and industrial operations we supply labour to.',
    icon: 'M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0zM12 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4z',
  },
];
---

<BaseLayout
  title={site.name}
  description="GLCL supplies skilled labour, general labour, equipment operators and supervisory support to maritime, port, logistics and industrial operations in Ghana. Based in the Tema Port enclave since 2013."
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__media" aria-hidden="true">
      <Image
        src={heroImg}
        alt=""
        widths={[640, 1024, 1600, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="container hero__inner">
      <div class="hero__content">
        <p class="eyebrow eyebrow--light">Maritime &amp; industrial labour supply — Tema, Ghana</p>
        <h1>Reliable labour.<br /><em>Ready for operations.</em></h1>
        <p class="hero__lead">
          GET Labour Company Limited (GLCL) supplies the skilled, general and supervisory
          manpower that keeps cargo, vessels and industrial sites moving — from the Tema
          Port enclave outward.
        </p>
        <div class="btn-row">
          <a class="btn btn--accent" href={url('/request-labour/')}>Request Labour</a>
          <a class="btn btn--outline-light" href={url('/apply/')}>Apply for Work</a>
        </div>
      </div>
    </div>
    <div class="hero__strip">
      <dl class="container hero__strip-grid">
        <div class="hero__strip-item">
          <dt>Established</dt>
          <dd>{site.founded}</dd>
        </div>
        <div class="hero__strip-item">
          <dt>Location</dt>
          <dd>Tema Meridian Road, Tema — Ghana</dd>
        </div>
        <div class="hero__strip-item">
          <dt>Workforce</dt>
          <dd>Skilled · General · Operators · Supervision</dd>
        </div>
        <div class="hero__strip-item">
          <dt>Sectors</dt>
          <dd>Maritime · Port · Logistics · Industrial</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Company introduction -->
  <section class="section">
    <div class="container split split--text-first">
      <div data-reveal>
        <p class="eyebrow">Who we are</p>
        <h2>The workforce behind everyday port and industrial operations</h2>
        <p class="color-slate">
          Founded in {site.founded}, GLCL connects businesses with reliable labour across the
          maritime, port, logistics and industrial environment around Tema. Companies come to
          us when they need people — skilled tradespeople, working gangs, machine operators or
          supervisors — organised, vetted and ready for the job.
        </p>
        <p class="color-slate">
          We keep the process straightforward: tell us what you need, discuss the details with
          our team, and confirm the arrangement directly with GLCL.
        </p>
        <a class="text-link" href={url('/about/')}>
          More about GLCL
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
      <figure class="media-frame" data-reveal style="margin:0">
        <Image src={teamImg} alt="The GLCL team at the company’s Tema premises" widths={[640, 900, 1240]} sizes="(min-width: 56rem) 50vw, 100vw" />
        <figcaption class="media-caption">The GLCL team — Tema, Ghana</figcaption>
      </figure>
    </div>
  </section>

  <!-- Services -->
  <section class="section section--paper" id="services">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">What we provide</p>
        <h2>Labour for the work that actually needs doing</h2>
        <p>Four workforce categories, supplied to your specification and agreed directly with our team.</p>
      </div>

      <div class="service-rows">
        {
          services.map((service, i) => (
            <article class="service-row" data-reveal>
              <div class="service-row__media">
                <Image
                  src={serviceImages[service.slug]}
                  alt=""
                  widths={[520, 800, 1100]}
                  sizes="(min-width: 56rem) 50vw, 100vw"
                  loading="lazy"
                />
              </div>
              <div>
                <span class="service-row__index">{`0${i + 1}`}</span>
                <h3>{service.title}</h3>
                <p>{service.short}</p>
                <ul class="chip-list mb-5">
                  {service.categories.slice(0, 4).map((c) => (
                    <li class="chip">{c.name}</li>
                  ))}
                </ul>
                <div class="btn-row">
                  <a class="text-link" href={url(`/services/${service.slug}/`)}>
                    Learn more
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </a>
                  <a class="btn btn--outline" href={url('/request-labour/')}>Request this labour</a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why GLCL -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Why work with GLCL</p>
        <h2>A workforce approach built on reliability</h2>
        <p>
          These are the practical reasons businesses around Tema continue to request labour
          through GLCL.
        </p>
      </div>
      <div class="value-grid value-grid--4" data-reveal>
        {
          values.map((v) => (
            <div class="value-card">
              <div class="value-card__icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={v.icon} /></svg>
              </div>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section section--paper">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">How labour requests work</p>
        <h2>From requirement to allocation in four steps</h2>
      </div>
      <ol class="steps" data-reveal style="list-style:none;padding:0;margin:0">
        <li class="step">
          <h3>Describe the requirement</h3>
          <p>Tell us the type of work, number of workers, location, start date and duration.</p>
        </li>
        <li class="step">
          <h3>Send it to GLCL</h3>
          <p>Use the labour request form, call +233 30 396 1288, or email our office.</p>
        </li>
        <li class="step">
          <h3>Discuss the details</h3>
          <p>Our team reviews availability and the specifics of your operation with you.</p>
        </li>
        <li class="step">
          <h3>Confirm the arrangement</h3>
          <p>Terms and allocations are agreed directly between GLCL and your company.</p>
        </li>
      </ol>
      <p class="field-hint mt-0" data-reveal style="margin-top:1.5rem">
        Every request is assessed individually — availability depends on the requirement and operational circumstances at the time.
      </p>
    </div>
  </section>

  <!-- Employment pathway -->
  <section class="section employment-band">
    <div class="container split split--media-first">
      <figure class="media-frame" data-reveal style="margin:0">
        <Image
          src={musterImg}
          alt="Workers gathering at a GLCL labour muster point"
          widths={[520, 800, 1100]}
          sizes="(min-width: 56rem) 50vw, 100vw"
          loading="lazy"
        />
      </figure>
      <div data-reveal>
        <p class="eyebrow">Looking for work?</p>
        <h2>Your next opportunity can start here</h2>
        <p class="color-slate">
          GLCL registers people interested in general labour, skilled work, equipment operation
          and supervisory roles. Registering your interest takes a few minutes — actual placement
          depends on client requirements and the suitability of your profile at the time.
        </p>
        <div class="btn-row mb-5">
          <a class="btn btn--primary" href={url('/apply/')}>Apply for Work</a>
          <a class="btn btn--outline" href={url('/careers/')}>How it works</a>
        </div>
        <ul class="chip-list">
          <li class="chip chip--amber">General labour</li>
          <li class="chip chip--amber">Skilled trades</li>
          <li class="chip chip--amber">Forklift &amp; heavy equipment</li>
          <li class="chip chip--amber">Supervisory roles</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Operations gallery -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Operational environment</p>
        <h2>Where our people work</h2>
        <p>
          Terminals, vessels, warehouses and industrial sites around Tema and Ghana’s maritime
          corridor.
        </p>
      </div>
      <div class="gallery-grid gallery-grid--3" data-reveal>
        <figure>
          <Image src={berthImg} alt="Container ships berthed alongside gantry cranes" widths={[420, 700, 1000]} sizes="(min-width: 60rem) 33vw, 100vw" loading="lazy" />
          <figcaption>Port and terminal operations</figcaption>
        </figure>
        <figure>
          <Image src={forkliftImg} alt="A forklift loading cargo into a shipping container at a port" widths={[420, 700, 1000]} sizes="(min-width: 60rem) 33vw, 100vw" loading="lazy" />
          <figcaption>Equipment and cargo handling</figcaption>
        </figure>
        <figure>
          <Image src={vesselImg} alt="A fully loaded container vessel under way at sea" widths={[420, 700, 1000]} sizes="(min-width: 60rem) 33vw, 100vw" loading="lazy" />
          <figcaption>Vessel and transit support</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--paper">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow">Common questions</p>
        <h2>Frequently asked questions</h2>
      </div>
      <FaqList />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
