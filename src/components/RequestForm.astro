---
import { emailjs, site, labourCategories, skilledRoles, gangTypes, url } from '../config/site';
---

<div class="form-panel">
  <div class="form-alert" data-alert hidden></div>

  <form
    data-glcl-form="request"
    data-emailjs-public={emailjs.publicKey}
    data-emailjs-service={emailjs.serviceId}
    data-emailjs-template={emailjs.templateId}
    data-company-email={site.email}
    novalidate
  >
    <div class="form-grid form-grid--2">
      <div class="field">
        <label for="req-fullname">Contact person’s name <span class="req" aria-hidden="true">*</span></label>
        <input id="req-fullname" name="fullname" type="text" autocomplete="name" required />
        <p class="field-error" id="req-fullname-error">Please enter your name.</p>
      </div>

      <div class="field">
        <label for="req-company">Company or organisation <span class="req" aria-hidden="true">*</span></label>
        <input id="req-company" name="company" type="text" autocomplete="organization" required />
        <p class="field-hint">If you are not a business, describe who you are in short.</p>
        <p class="field-error">Please enter your company or organisation.</p>
      </div>

      <div class="field">
        <label for="req-phone">Telephone <span class="req" aria-hidden="true">*</span></label>
        <input id="req-phone" name="phone" type="tel" autocomplete="tel" required placeholder="0XX XXX XXXX" />
        <p class="field-error">Please enter a telephone number.</p>
      </div>

      <div class="field">
        <label for="req-email">Email address <span class="req" aria-hidden="true">*</span></label>
        <input id="req-email" name="email" type="email" autocomplete="email" required />
        <p class="field-error">Please enter a valid email address.</p>
      </div>

      <div class="field field--full">
        <fieldset style="border:0;padding:0;margin:0">
          <legend>Preferred contact method <span class="req" aria-hidden="true">*</span></legend>
          <div class="radio-row" style="margin-top:.5rem">
            <label class="checkbox"><input type="radio" name="preferredContact" value="Telephone" required checked /> Telephone</label>
            <label class="checkbox"><input type="radio" name="preferredContact" value="Email" required /> Email</label>
            <label class="checkbox"><input type="radio" name="preferredContact" value="Either" required /> Either is fine</label>
          </div>
        </fieldset>
      </div>

      <div class="field field--full">
        <label for="req-category">Labour category <span class="req" aria-hidden="true">*</span></label>
        <select id="req-category" name="labourCategorySingle" required>
          <option value="">Select the type of labour you need…</option>
          {labourCategories.map((c) => <option value={c.label}>{c.label}</option>)}
        </select>
        <p class="field-error">Please choose a labour category.</p>
      </div>

      <!-- Conditional: specific skilled / support roles -->
      <div class="field field--full conditional-group" data-when-category="skilled,supervision,equipment">
        <fieldset>
          <legend>Specific roles (optional)</legend>
          <p class="field-hint" style="margin-bottom:.75rem">Tick any roles that apply — leave blank if you are not sure.</p>
          <div class="checkbox-grid">
            {skilledRoles.map((role) => (
              <label class="checkbox">
                <input type="checkbox" name="skilledRole" value={role} />
                {role}
              </label>
            ))}
          </div>
        </fieldset>
      </div>

      <!-- Conditional: general labour gang types -->
      <div class="field field--full conditional-group" data-when-category="general">
        <fieldset>
          <legend>Type of general labour (optional)</legend>
          <div class="checkbox-grid">
            {gangTypes.map((gang) => (
              <label class="checkbox">
                <input type="checkbox" name="gangType" value={gang} />
                {gang}
              </label>
            ))}
          </div>
        </fieldset>
      </div>

      <!-- Conditional: other description -->
      <div class="field field--full conditional-group" data-when-category="other">
        <label for="req-other">Describe the labour you need</label>
        <input id="req-other" name="otherCategory" type="text" placeholder="e.g. cleaners for a warehouse in Tema" />
      </div>

      <div class="field">
        <label for="req-count">Number of workers</label>
        <input id="req-count" name="workerCount" type="number" min="1" inputmode="numeric" placeholder="e.g. 12" />
      </div>

      <div class="field">
        <label for="req-operation">Type of operation</label>
        <input id="req-operation" name="operationType" type="text" placeholder="e.g. stevedoring, warehouse, site work" />
      </div>

      <div class="field">
        <label for="req-start">Preferred start date</label>
        <input id="req-start" name="startDate" type="date" />
      </div>

      <div class="field">
        <label for="req-duration">Expected duration</label>
        <input id="req-duration" name="duration" type="text" placeholder="e.g. one shift, two weeks, ongoing" />
      </div>

      <div class="field field--full">
        <label for="req-location">Work location</label>
        <input id="req-location" name="workLocation" type="text" placeholder="e.g. Tema Port, Community 1, Accra" />
      </div>

      <div class="field field--full">
        <label for="req-description">Brief description of the requirement <span class="req" aria-hidden="true">*</span></label>
        <textarea
          id="req-description"
          name="description"
          required
          placeholder="Describe the work, any skills or equipment experience needed, shift pattern, and anything else our team should know."></textarea>
        <p class="field-error">Please describe what you need.</p>
      </div>

      <div class="field field--full">
        <label for="req-skills">Relevant skills or equipment experience</label>
        <textarea id="req-skills" name="skills" placeholder="Optional — any specific experience or certification your operation requires"></textarea>
      </div>

      <!-- Honeypot: hidden from real visitors, catches simple bots -->
      <div class="honeypot" aria-hidden="true">
        <label for="req-website">Website</label>
        <input id="req-website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="field field--full">
        <p class="form-notice">
          Your details are used only to respond to this request and to arrange the labour you
          ask for. They are not sold or shared for marketing.
          <a href={url('/privacy/')}>Privacy policy</a>
        </p>
      </div>

      <div class="field field--full form-actions">
        <button class="btn btn--accent btn--block" type="submit">Send labour request</button>
        <p class="field-hint text-center mb-0">
          Prefer to talk? Call <a href="tel:+233303961288">+233 30 396 1288</a> or
          <a href="tel:+233558007876">+233 55 800 7876</a>.
        </p>
      </div>
    </div>
  </form>

  <div class="form-success" data-success-for="request">
    <div class="form-success__badge" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
    </div>
    <h2>Your request has been sent</h2>
    <p>
      Thank you — GLCL has received your labour request by email. A member of the team will
      contact you using your preferred method to discuss availability and next steps.
    </p>
    <p>
      If your operation is urgent, call <a href="tel:+233303961288">+233 30 396 1288</a> or
      <a href="tel:+233558007876">+233 55 800 7876</a> and mention that you have submitted a request.
    </p>
    <a class="btn btn--outline" href={url('/request-labour/')} onclick="location.reload();return false;">Submit another request</a>
  </div>
</div>

<script>
  import '../scripts/forms.js';

  // Show/hide role groups based on the selected labour category.
  const select = document.getElementById('req-category');
  const groups = document.querySelectorAll('[data-when-category]');
  const sync = () => {
    const value = select?.value ?? '';
    const key =
      value.includes('Skilled') ? 'skilled'
      : value.includes('General') ? 'general'
      : value.includes('Equipment') ? 'equipment'
      : value.includes('Supervision') ? 'supervision'
      : value.includes('Other') ? 'other'
      : '';
    groups.forEach((group) => {
      const match = group.getAttribute('data-when-category')?.split(',').includes(key);
      group.classList.toggle('is-visible', Boolean(match));
    });
  };
  select?.addEventListener('change', sync);
  sync();
</script>
